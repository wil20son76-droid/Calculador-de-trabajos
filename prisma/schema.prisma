// Schema de base de datos para la aplicación de presupuestos de construcción/reformas.
// Diseñado para una empresa de reformas en Suecia, pero flexible para cualquier tipo de trabajo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Empresa / usuarios
// ---------------------------------------------------------------------------

model Company {
  id      String @id @default(cuid())
  name    String
  logoUrl String?

  orgNumber String? // organisationsnummer
  vatNumber String? // VAT number

  address    String?
  postalCode String?
  city       String?
  country    String  @default("Sverige")
  phone      String?
  email      String?
  website    String?

  bankgiro String?
  plusgiro String?
  swish    String?

  currency String @default("SEK")
  locale   String @default("sv") // idioma por defecto de la interfaz para esta empresa

  vatRatePercent               Decimal @default(25) @db.Decimal(6, 3)
  rotEnabledDefault             Boolean @default(true)
  rotPercent                    Decimal @default(50) @db.Decimal(6, 3) // % deducible sobre mano de obra, configurable (cambia con la ley)
  rotMaxDeductionPerQuote       Decimal? @db.Decimal(12, 2) // tope opcional, configurable
  defaultHourlyRate             Decimal @default(0) @db.Decimal(12, 2)
  defaultMaterialMarginPercent  Decimal @default(0) @db.Decimal(6, 3)
  quoteValidityDays             Int     @default(30)
  defaultTermsText              String? @db.Text
  nextQuoteSequence             Int     @default(1) // contador para generar OFF-YYYY-XXX

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  customers         Customer[]
  projects          Project[]
  quotes            Quote[]
  jobCategories     JobCategory[]
  priceListItems    PriceListItem[]
  materialLibrary   MaterialLibraryItem[]
  templates         Template[]
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Clientes / Proyectos
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  companyName String? // empresa del cliente, si corresponde

  address    String?
  postalCode String?
  city       String?
  phone      String?
  email      String?

  personalOrgNumber String? // personnummer u organisationsnummer

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  quotes   Quote[]

  @@index([companyId])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Project {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name    String
  address String?
  postalCode String?
  city    String?
  status  ProjectStatus @default(PLANNING)
  startDate DateTime?
  endDate   DateTime?
  notes   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([companyId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Bibliotecas reutilizables: categorías de trabajo, lista de precios, materiales
// ---------------------------------------------------------------------------

model JobCategory {
  id        String  @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key       String // slug estable, ej "painting-interior"
  name      String
  nameSv    String?
  sortOrder Int    @default(0)

  priceListItems PriceListItem[]

  @@index([companyId])
}

enum PricingMethod {
  FIXED   // precio fijo
  HOURLY  // por hora
  PER_M2  // por metro cuadrado
  PER_METER // por metro lineal
  PER_UNIT // por unidad
  PER_DAY // por día
}

enum WorkUnit {
  UNIT
  HOUR
  M2
  M3
  METER
  DAY
  KG
  TON
  LITER
  BAG
  PACKAGE
  BOX
  ROLL
}

// Biblioteca de precios / trabajos habituales (sección 2, 3 y 11)
model PriceListItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String?
  category   JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name            String
  nameSv          String?
  description     String? @db.Text
  pricingMethod   PricingMethod @default(FIXED)
  unit            WorkUnit      @default(UNIT)
  defaultUnitPrice Decimal      @default(0) @db.Decimal(12, 2)
  defaultHourlyRate Decimal?    @db.Decimal(12, 2)
  isSystem        Boolean @default(false) // seed vs. creado por el usuario

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteItems QuoteItem[]

  @@index([companyId])
  @@index([categoryId])
}

enum MaterialUnit {
  UNIT
  METER
  M2
  M3
  KG
  TON
  LITER
  BAG
  PACKAGE
  BOX
  ROLL
}

// Biblioteca de materiales (sección 12)
model MaterialLibraryItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  unit           MaterialUnit @default(UNIT)
  purchasePrice  Decimal      @default(0) @db.Decimal(12, 2)
  marginPercent  Decimal      @default(0) @db.Decimal(6, 3)
  supplier       String?
  sku            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteMaterials QuoteMaterial[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Plantillas de proyecto (sección 15): precargan varios trabajos habituales
// ---------------------------------------------------------------------------

model Template {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TemplateItem[]

  @@index([companyId])
}

model TemplateItem {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name              String
  descriptionClient String?
  pricingMethod     PricingMethod @default(FIXED)
  unit              WorkUnit      @default(UNIT)
  quantity          Decimal       @default(1) @db.Decimal(12, 3)
  unitPrice         Decimal       @default(0) @db.Decimal(12, 2)
  sortOrder         Int           @default(0)

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Presupuesto (Quote) — el núcleo de la aplicación
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  INVOICED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

model Quote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  quoteNumber String // ej. OFF-2026-001
  status      QuoteStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Datos del proyecto / obra
  projectName        String?
  projectDescription String? @db.Text
  siteAddressDifferent Boolean @default(false)
  siteAddress        String?
  sitePostalCode     String?
  siteCity           String?

  quoteDate  DateTime @default(now())
  validUntil DateTime?

  currency String @default("SEK")

  // Snapshot de reglas fiscales/comerciales de la empresa en el momento de crear el presupuesto
  vatRatePercent Decimal @default(25) @db.Decimal(6, 3)
  rotEnabled     Boolean @default(false)
  rotPercent     Decimal @default(50) @db.Decimal(6, 3)

  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)

  materialMarginDefaultPercent Decimal @default(0) @db.Decimal(6, 3)

  // Visibilidad del PDF (sección 20) — el margen/beneficio interno NUNCA se muestra
  showHours                Boolean @default(true)
  showHourlyRate           Boolean @default(true)
  showMaterialsIndividually Boolean @default(true)
  showMaterialPrices       Boolean @default(true)
  showUnitPrice            Boolean @default(true)
  showOnlyTotalPerJob      Boolean @default(false)
  showMaterialsOnPdf       Boolean @default(true)

  includedText   String? @db.Text
  excludedText   String? @db.Text
  termsText      String? @db.Text
  notesInternal  String? @db.Text
  notesClient    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Totales calculados en el servidor (motor de cálculo) y cacheados aquí para
  // listados y dashboard. Los items siguen siendo la fuente de la verdad: estos
  // campos se recalculan siempre que se guarda el presupuesto.
  cachedLaborTotal    Decimal @default(0) @db.Decimal(12, 2)
  cachedMaterialTotal Decimal @default(0) @db.Decimal(12, 2)
  cachedOtherTotal    Decimal @default(0) @db.Decimal(12, 2)
  cachedSubtotal      Decimal @default(0) @db.Decimal(12, 2)
  cachedVatAmount     Decimal @default(0) @db.Decimal(12, 2)
  cachedTotalInclVat  Decimal @default(0) @db.Decimal(12, 2)
  cachedRotDeduction  Decimal @default(0) @db.Decimal(12, 2)
  cachedTotalDue      Decimal @default(0) @db.Decimal(12, 2)
  cachedCostInternal  Decimal @default(0) @db.Decimal(12, 2)
  cachedGrossProfit   Decimal @default(0) @db.Decimal(12, 2)
  cachedMarginPercent Decimal @default(0) @db.Decimal(6, 2)

  items      QuoteItem[]
  otherCosts QuoteOtherCost[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

// Línea de trabajo dentro de un presupuesto (sección 3, 4, 16, 17)
model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  priceListItemId String?
  priceListItem   PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: SetNull)

  categoryName String? // denormalizado, para presupuestos flexibles fuera de categorías estándar
  name         String

  descriptionInternal String? @db.Text // nunca se muestra en el PDF
  descriptionClient   String? @db.Text // se muestra en el PDF si se desea

  includedText String? @db.Text
  excludedText String? @db.Text

  pricingMethod PricingMethod @default(FIXED)
  unit          WorkUnit      @default(UNIT)

  // Cálculo por cantidad x precio unitario (cubre precio fijo, m², metro lineal, unidad, día)
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)

  // Modo horas (sección 4): si se usa, quantity/unitPrice se derivan de estas horas
  useDetailedLabor Boolean @default(false)
  workerCount      Decimal? @db.Decimal(8, 2)
  hoursPerWorker   Decimal? @db.Decimal(8, 2)
  hourlyRate       Decimal? @db.Decimal(12, 2)

  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)

  // Coste interno de la empresa para esta línea (p.ej. salarios reales pagados).
  // Uso exclusivamente interno: nunca se expone en el PDF del cliente.
  companyCost Decimal? @db.Decimal(12, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials QuoteMaterial[]

  @@index([quoteId])
  @@index([priceListItemId])
}

// Material asociado a una línea de trabajo (sección 5, 6)
model QuoteMaterial {
  id          String    @id @default(cuid())
  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  materialLibraryItemId String?
  materialLibraryItem   MaterialLibraryItem? @relation(fields: [materialLibraryItemId], references: [id], onDelete: SetNull)

  name          String
  description   String?
  quantity      Decimal      @default(1) @db.Decimal(12, 3)
  unit          MaterialUnit @default(UNIT)
  purchasePrice Decimal      @default(0) @db.Decimal(12, 2)
  marginPercent Decimal      @default(0) @db.Decimal(6, 3)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteItemId])
}

// Otros costes del presupuesto (sección 7): transporte, parking, contenedor, etc.
model QuoteOtherCost {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  name      String
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([quoteId])
}
