// Schema de base de datos para la aplicación de presupuestos de construcción/reformas.
// Diseñado para una empresa de reformas en Suecia, pero flexible para cualquier tipo de trabajo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Empresa / usuarios
// ---------------------------------------------------------------------------

model Company {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  orgNumber String? // organisationsnummer
  vatNumber String? // VAT number

  address    String?
  postalCode String?
  city       String?
  country    String  @default("Sverige")
  phone      String?
  email      String?
  website    String?

  bankgiro String?
  plusgiro String?
  swish    String?

  currency String @default("SEK")
  locale   String @default("sv") // idioma por defecto de la interfaz para esta empresa

  vatRatePercent               Decimal  @default(25) @db.Decimal(6, 3)
  rotEnabledDefault            Boolean  @default(true)
  rotPercent                   Decimal  @default(50) @db.Decimal(6, 3) // % deducible sobre mano de obra, configurable (cambia con la ley)
  rotMaxDeductionPerQuote      Decimal? @db.Decimal(12, 2) // tope opcional, configurable
  defaultHourlyRate            Decimal  @default(0) @db.Decimal(12, 2)
  defaultInternalHourlyRate    Decimal  @default(0) @db.Decimal(12, 2) // coste interno/hora predeterminado
  defaultMaterialMarginPercent Decimal  @default(0) @db.Decimal(6, 3)
  defaultWastePercent          Decimal  @default(0) @db.Decimal(6, 3) // desperdicio predeterminado si un material no tiene uno propio
  quoteValidityDays            Int      @default(30)
  defaultTermsText             String?  @db.Text
  nextQuoteSequence            Int      @default(1) // contador para generar OFF-YYYY-XXX

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  projects        Project[]
  quotes          Quote[]
  jobCategories   JobCategory[]
  priceListItems  PriceListItem[]
  materialLibrary MaterialLibraryItem[]
  templates       Template[]
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Clientes / Proyectos
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String?
  companyName String? // empresa del cliente, si corresponde

  address    String?
  postalCode String?
  city       String?
  phone      String?
  email      String?

  personalOrgNumber String? // personnummer u organisationsnummer

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  quotes   Quote[]

  @@index([companyId])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Project {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name       String
  address    String?
  postalCode String?
  city       String?
  status     ProjectStatus @default(PLANNING)
  startDate  DateTime?
  endDate    DateTime?
  notes      String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([companyId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Habitaciones / zonas y mediciones (calculador de habitaciones)
// ---------------------------------------------------------------------------

enum OpeningType {
  DOOR
  WINDOW
  OTHER
}

// Habitación o zona dentro de un presupuesto: guarda las dimensiones brutas.
// El resto de medidas (suelo, techo, perímetro, paredes brutas/netas) se derivan
// siempre a partir de estos valores en el motor de cálculo — nunca se guardan
// duplicadas, para que reflejen siempre el estado actual de la habitación.
model Room {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  name   String
  length Decimal @db.Decimal(8, 3) // largo, metros
  width  Decimal @db.Decimal(8, 3) // ancho, metros
  height Decimal @db.Decimal(8, 3) // altura, metros

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  openings  RoomOpening[]
  itemLinks QuoteItemRoom[]

  @@index([quoteId])
}

// Puertas / ventanas / otras aberturas a descontar de las paredes de una habitación.
model RoomOpening {
  id     String      @id @default(cuid())
  roomId String
  room   Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type   OpeningType @default(DOOR)

  width    Decimal @db.Decimal(8, 3)
  height   Decimal @db.Decimal(8, 3)
  quantity Int     @default(1)

  sortOrder Int @default(0)

  @@index([roomId])
}

// ---------------------------------------------------------------------------
// Bibliotecas reutilizables: categorías de trabajo, lista de precios, materiales
// ---------------------------------------------------------------------------

model JobCategory {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key       String // slug estable, ej "painting-interior"
  name      String
  nameSv    String?
  sortOrder Int     @default(0)

  priceListItems PriceListItem[]

  @@index([companyId])
}

enum PricingMethod {
  FIXED // precio fijo
  HOURLY // por hora
  PER_M2 // por metro cuadrado
  PER_METER // por metro lineal
  PER_UNIT // por unidad
  PER_DAY // por día
}

enum WorkUnit {
  UNIT
  HOUR
  M2
  M3
  METER
  DAY
  KG
  TON
  LITER
  BAG
  PACKAGE
  BOX
  ROLL
}

// Biblioteca de precios / trabajos habituales (sección 2, 3 y 11)
model PriceListItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String?
  category   JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name              String
  nameSv            String?
  description       String?       @db.Text
  pricingMethod     PricingMethod @default(FIXED)
  unit              WorkUnit      @default(UNIT)
  defaultUnitPrice  Decimal       @default(0) @db.Decimal(12, 2)
  defaultHourlyRate Decimal?      @db.Decimal(12, 2)
  isSystem          Boolean       @default(false) // seed vs. creado por el usuario

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteItems QuoteItem[]

  @@index([companyId])
  @@index([categoryId])
}

enum MaterialUnit {
  UNIT
  METER
  M2
  M3
  KG
  TON
  LITER
  BAG
  PACKAGE
  BOX
  ROLL
}

// Cómo se calcula automáticamente la cantidad necesaria de un material a partir
// de una superficie/longitud (sección "cálculo automático de pintura y suelos").
enum MaterialCalcType {
  NONE // cantidad siempre manual
  PAINT // litros = (área × manos / rendimiento) × (1 + desperdicio), con sugerencia de envases
  COVERAGE // consumo por m² (pegamento, barniz, imprimación...): área × consumo, con desperdicio opcional
  PACKAGE // superficie en paquetes (parquet, laminado...): ceil((área × (1+desperdicio)) / m² por paquete)
}

// Biblioteca de materiales (sección 12)
model MaterialLibraryItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  unit          MaterialUnit @default(UNIT)
  purchasePrice Decimal      @default(0) @db.Decimal(12, 2)
  marginPercent Decimal      @default(0) @db.Decimal(6, 3)
  supplier      String?
  sku           String?

  // Valores por defecto para el cálculo automático (editables en cada presupuesto)
  calcType            MaterialCalcType @default(NONE)
  coveragePerUnit     Decimal?         @db.Decimal(10, 3) // rendimiento: m² por litro/kg
  coatsDefault        Int? // manos por defecto (pintura/barniz)
  wastePercentDefault Decimal          @default(0) @db.Decimal(6, 3)
  packageSize         Decimal?         @db.Decimal(10, 3) // tamaño de envase/paquete en la unidad natural (L, kg, m²)
  containerSizes      Json? // tamaños de envase disponibles, p.ej. [1,2.7,5,9,10] (litros)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteMaterials QuoteMaterial[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Plantillas de proyecto (sección 15): precargan varios trabajos habituales
// ---------------------------------------------------------------------------

model Template {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TemplateItem[]

  @@index([companyId])
}

model TemplateItem {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name              String
  descriptionClient String?
  pricingMethod     PricingMethod @default(FIXED)
  unit              WorkUnit      @default(UNIT)
  quantity          Decimal       @default(1) @db.Decimal(12, 3)
  unitPrice         Decimal       @default(0) @db.Decimal(12, 2)
  sortOrder         Int           @default(0)

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Presupuesto (Quote) — el núcleo de la aplicación
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  INVOICED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

model Quote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  quoteNumber String // ej. OFF-2026-001
  status      QuoteStatus @default(DRAFT)

  // Sin gestión de clientes en el flujo principal (los datos oficiales del cliente
  // se gestionan en Fortnox): el vínculo con Customer es opcional, para no perder
  // la posibilidad de reactivarlo más adelante.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Datos del proyecto / obra
  projectName          String?
  projectDescription   String? @db.Text
  siteAddressDifferent Boolean @default(false)
  siteAddress          String?
  sitePostalCode       String?
  siteCity             String?

  quoteDate  DateTime  @default(now())
  validUntil DateTime?

  currency String @default("SEK")

  // Snapshot de reglas fiscales/comerciales de la empresa en el momento de crear el presupuesto
  vatRatePercent Decimal @default(25) @db.Decimal(6, 3)
  rotEnabled     Boolean @default(false)
  rotPercent     Decimal @default(50) @db.Decimal(6, 3)

  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)

  materialMarginDefaultPercent Decimal @default(0) @db.Decimal(6, 3)

  // Visibilidad del PDF (sección 20) — el margen/beneficio interno NUNCA se muestra
  showHours                 Boolean @default(true)
  showHourlyRate            Boolean @default(true)
  showMaterialsIndividually Boolean @default(true)
  showMaterialPrices        Boolean @default(true)
  showUnitPrice             Boolean @default(true)
  showOnlyTotalPerJob       Boolean @default(false)
  showMaterialsOnPdf        Boolean @default(true)

  includedText  String? @db.Text
  excludedText  String? @db.Text
  termsText     String? @db.Text
  notesInternal String? @db.Text
  notesClient   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Totales calculados en el servidor (motor de cálculo) y cacheados aquí para
  // listados y dashboard. Los items siguen siendo la fuente de la verdad: estos
  // campos se recalculan siempre que se guarda el presupuesto.
  cachedLaborTotal           Decimal @default(0) @db.Decimal(12, 2)
  cachedMaterialTotal        Decimal @default(0) @db.Decimal(12, 2)
  cachedOtherTotal           Decimal @default(0) @db.Decimal(12, 2)
  cachedSubtotal             Decimal @default(0) @db.Decimal(12, 2)
  cachedVatAmount            Decimal @default(0) @db.Decimal(12, 2)
  cachedTotalInclVat         Decimal @default(0) @db.Decimal(12, 2)
  cachedRotDeduction         Decimal @default(0) @db.Decimal(12, 2)
  cachedTotalDue             Decimal @default(0) @db.Decimal(12, 2)
  cachedCostInternal         Decimal @default(0) @db.Decimal(12, 2)
  cachedLaborCostInternal    Decimal @default(0) @db.Decimal(12, 2)
  cachedMaterialCostInternal Decimal @default(0) @db.Decimal(12, 2)
  cachedGrossProfit          Decimal @default(0) @db.Decimal(12, 2)
  cachedMarginPercent        Decimal @default(0) @db.Decimal(6, 2)

  items      QuoteItem[]
  otherCosts QuoteOtherCost[]
  rooms      Room[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

enum MeasurementSource {
  NONE // cantidad introducida manualmente
  NET_WALL // paredes netas (bruto - puertas/ventanas) de las habitaciones seleccionadas
  GROSS_WALL // paredes brutas (sin descontar aberturas)
  CEILING // techo (= superficie de suelo)
  FLOOR // suelo
  PERIMETER // perímetro, opcionalmente menos el ancho de las puertas (rodapiés)
}

// Línea de trabajo dentro de un presupuesto (sección 3, 4, 16, 17)
model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  priceListItemId String?
  priceListItem   PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: SetNull)

  categoryName String? // denormalizado, para presupuestos flexibles fuera de categorías estándar
  name         String

  descriptionInternal String? @db.Text // nunca se muestra en el PDF
  descriptionClient   String? @db.Text // se muestra en el PDF si se desea

  includedText String? @db.Text
  excludedText String? @db.Text

  pricingMethod PricingMethod @default(FIXED)
  unit          WorkUnit      @default(UNIT)

  // Cálculo por cantidad x precio unitario (cubre precio fijo, m², metro lineal, unidad, día)
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)

  // Modo horas (sección 4): si se usa, quantity/unitPrice se derivan de estas horas
  useDetailedLabor Boolean  @default(false)
  workerCount      Decimal? @db.Decimal(8, 2)
  hoursPerWorker   Decimal? @db.Decimal(8, 2)
  hourlyRate       Decimal? @db.Decimal(12, 2)

  // Coste interno real por hora (p.ej. salario/hora pagado al trabajador), distinto
  // del precio/hora facturado al cliente. Solo se usa junto con useDetailedLabor.
  internalHourlyRate Decimal? @db.Decimal(12, 2)

  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)

  // Coste interno adicional de la empresa para esta línea (p.ej. subcontratas).
  // Uso exclusivamente interno: nunca se expone en el PDF del cliente.
  companyCost Decimal? @db.Decimal(12, 2)

  // ROT-berättigad: si la mano de obra de esta línea es elegible para la deducción
  // ROT. Los materiales y otros costes nunca entran en la base del ROT.
  rotEligible Boolean @default(true)

  // Calculador de habitaciones: de dónde se obtiene la cantidad (sección "reutilizar mediciones")
  measurementSource     MeasurementSource @default(NONE)
  subtractOpeningWidths Boolean           @default(false) // para rodapiés: restar ancho de puertas del perímetro

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials QuoteMaterial[]
  rooms     QuoteItemRoom[]

  @@index([quoteId])
  @@index([priceListItemId])
}

// Habitaciones seleccionadas como origen de medición para una línea de trabajo.
// Varias habitaciones pueden sumarse (p.ej. "Salón + dormitorios + pasillo").
model QuoteItemRoom {
  id          String    @id @default(cuid())
  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([quoteItemId, roomId])
  @@index([quoteItemId])
  @@index([roomId])
}

// Material asociado a una línea de trabajo (sección 5, 6)
model QuoteMaterial {
  id          String    @id @default(cuid())
  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  materialLibraryItemId String?
  materialLibraryItem   MaterialLibraryItem? @relation(fields: [materialLibraryItemId], references: [id], onDelete: SetNull)

  name          String
  description   String?
  quantity      Decimal      @default(1) @db.Decimal(12, 3) // cantidad final presupuestada/a comprar
  unit          MaterialUnit @default(UNIT)
  purchasePrice Decimal      @default(0) @db.Decimal(12, 2)
  marginPercent Decimal      @default(0) @db.Decimal(6, 3)

  // Cálculo automático a partir de la medición de la línea (habitaciones seleccionadas)
  calcType           MaterialCalcType @default(NONE)
  coveragePerUnit    Decimal?         @db.Decimal(10, 3)
  coats              Int?
  wastePercent       Decimal          @default(0) @db.Decimal(6, 3)
  packageSize        Decimal?         @db.Decimal(10, 3)
  containerSizes     Json?
  // Última cantidad calculada automáticamente (en la unidad natural: L, kg, m²), para
  // poder detectar y avisar si difiere de `quantity` tras cambiar una habitación.
  calculatedQuantity Decimal?         @db.Decimal(12, 3)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteItemId])
}

// Otros costes del presupuesto (sección 7): transporte, parking, contenedor, etc.
model QuoteOtherCost {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  name      String
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([quoteId])
}
